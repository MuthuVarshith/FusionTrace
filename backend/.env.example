# Comma-separated browser origins allowed to call the API.
FUSIONTRACE_CORS_ORIGINS=http://localhost:8000
# Uploaded files and generated artifacts older than this are deleted at startup
# and before each new scan. Use an external scheduled job for strict guarantees.
FUSIONTRACE_RETENTION_HOURS=24
FUSIONTRACE_MAX_UPLOAD_MB=200
# Optional absolute paths when models/data live outside the backend directory.
# FUSIONTRACE_AUDIO_MODEL_PATH=models/audio_model
# FUSIONTRACE_IMAGE_MODEL_PATH=models/image_model/EfficientnetV2_model.pth
# FUSIONTRACE_DATA_DIR=data

# Optional: Google Gemini API key for AI-generated forensic report summaries.
# Get a free key at https://aistudio.google.com/app/apikey
# Without this key, scans still complete — the ai_summary field will be null.
# GEMINI_API_KEY=your_key_here
