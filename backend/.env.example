# FusionTrace environment settings. Copy to backend/.env and adjust.
# Every variable is optional; the values shown are the defaults unless noted.

# ── Server ──────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
FUSIONTRACE_CORS_ORIGINS=http://localhost:8000
# Python logging level: DEBUG, INFO, WARNING, ERROR.
FUSIONTRACE_LOG_LEVEL=INFO
# Where uploads, artifacts and the SQLite database live (relative to backend/).
# FUSIONTRACE_DATA_DIR=data

# ── Authentication (off when unset) ─────────────────────────────────────────
# Comma-separated API keys. When set, every /api/* request must send the
# header "X-API-Key: <key>", and each key only sees its own scans. Scans store
# a hash of the key, never the key. Local use needs nothing.
# FUSIONTRACE_API_KEYS=change-me-1,change-me-2

# ── Rate limits (per API key, or per client IP when auth is off; 0 = off) ───
FUSIONTRACE_RATE_LIMIT_WINDOW_SECONDS=60
FUSIONTRACE_UPLOAD_RATE_LIMIT=10
FUSIONTRACE_FEEDBACK_RATE_LIMIT=30

# ── Scan queue ──────────────────────────────────────────────────────────────
# Scans run on an in-process worker pool; run a single application process.
FUSIONTRACE_MAX_CONCURRENT_SCANS=1
# Uploads are refused with 503 while this many scans are already waiting.
FUSIONTRACE_MAX_QUEUED_SCANS=50
# Processing budget per scan in seconds (0 = no budget).
FUSIONTRACE_SCAN_TIMEOUT_SECONDS=900
# SQLite busy timeout in milliseconds (WAL mode is always on).
FUSIONTRACE_SQLITE_BUSY_TIMEOUT_MS=5000

# ── Upload limits and validation ────────────────────────────────────────────
FUSIONTRACE_MAX_UPLOAD_MB=200
# Images have their own, lower cap (never above FUSIONTRACE_MAX_UPLOAD_MB).
FUSIONTRACE_MAX_IMAGE_MB=30
# Decompression-bomb guard: maximum width x height of an uploaded image.
FUSIONTRACE_MAX_IMAGE_PIXELS=64000000
# Audio/video are checked with ffprobe (must be on PATH); longer files are rejected.
FUSIONTRACE_MAX_AUDIO_SECONDS=600
FUSIONTRACE_MAX_VIDEO_SECONDS=600

# ── Retention ───────────────────────────────────────────────────────────────
# Uploads and heatmaps older than this are deleted at startup and before each
# new scan (files of queued/processing scans are never touched). Per-scan
# working files are deleted as soon as the scan finishes.
FUSIONTRACE_RETENTION_HOURS=24

# ── Detectors (app/detectors/registry.py; defaults come from config.yaml) ───
# <KIND> is IMAGE, AUDIO or VIDEO.
# FUSIONTRACE_IMAGE_ENABLED=true
# FUSIONTRACE_IMAGE_MODEL=default
# FUSIONTRACE_IMAGE_WEIGHT=0.9
# FUSIONTRACE_AUDIO_ENABLED=true
# FUSIONTRACE_AUDIO_MODEL=default
# FUSIONTRACE_AUDIO_WEIGHT=0.9
# FUSIONTRACE_VIDEO_ENABLED=true
# FUSIONTRACE_VIDEO_MODEL=default
# FUSIONTRACE_VIDEO_WEIGHT=0.7
# Root folder for downloaded detector weights (relative to backend/).
# FUSIONTRACE_MODEL_DIR=models
# auto picks CUDA when available, otherwise CPU.
FUSIONTRACE_DEVICE=auto
# Load all enabled detectors in the background at startup (0 = load on first use).
FUSIONTRACE_WARMUP=1
# Legacy FusionTrace weight locations (used by the legacy detectors).
# FUSIONTRACE_AUDIO_MODEL_PATH=models/audio_model
# FUSIONTRACE_IMAGE_MODEL_PATH=models/image_model/EfficientnetV2_model.pth

# ── Model download (scripts/download_models.py) ─────────────────────────────
# Hugging Face repo holding (private mirrors of) the weights, and a token for
# private repos.
# HF_REPO_ID=your-username/FusionTrace-models
# HF_TOKEN=hf_xxx

# ── Optional AI summary (Google Gemini) ─────────────────────────────────────
# Without a key the app works fully; the opt-in checkbox shows "unavailable".
# With a key, a summary is generated only for scans where the uploader ticks
# the box, and only detector scores are sent — never the media file.
# GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash
