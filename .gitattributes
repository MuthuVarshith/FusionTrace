# Text files are stored with LF in the repository and checked out with LF on
# every platform (Docker builds and shell scripts break on CRLF).
* text=auto eol=lf

# Binary files: no line-ending conversion, no textual diff.
*.pth binary
*.pt binary
*.ckpt binary
*.bin binary
*.onnx binary
*.safetensors binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.wav binary
*.mp3 binary
*.flac binary
*.m4a binary
*.mp4 binary
*.webm binary
*.pdf binary
*.db binary

# Git LFS is no longer used. Model weights are downloaded from the Hugging Face
# Hub by backend/scripts/download_models.py; backend/models/ is gitignored.
# Purging the old LFS objects from history: docs/lfs-cleanup.md.
